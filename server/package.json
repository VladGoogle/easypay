{
  "name": "easy-pay",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json",
    "check-db-connection": "node -r tsconfig-paths/register -r ts-node/register ./database/index.ts",
    "migration:up": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli migration:run -d database/data-source.ts",
    "migration:show": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli migration:show -d database/data-source.ts",
    "migration:create": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli migration:create",
    "migration:revert": "node -r tsconfig-paths/register -r ts-node/register ./node_modules/typeorm/cli migration:revert -d database/data-source.ts",
    "seed-db": "node -r tsconfig-paths/register -r ts-node/register"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.731.1",
    "@aws-sdk/client-ses": "^3.731.1",
    "@elastic/elasticsearch": "8.17.0",
    "@nestjs/bull": "^11.0.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/cache-manager": "^3.0.0",
